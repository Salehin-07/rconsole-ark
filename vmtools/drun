#!/bin/sh
# drun - short for `docker run`, always local (udocker): drun hello-world
# See `docker --help` for what is and is not supported.
DOCKER_SHIM_LOCAL=1
export DOCKER_SHIM_LOCAL
here="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
case "${1:-}" in ""|-h|--help) exec "$here/docker" --help ;; esac
exec "$here/docker" run "$@"
