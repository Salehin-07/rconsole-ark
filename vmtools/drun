#!/bin/sh
# drun - run a Docker image WITHOUT a Docker daemon (a thin wrapper around udocker, proot mode).
#
#   drun hello-world
#   drun python:3.12-slim python -c 'print("hi")'
#   DRUN_OPTS="-e FOO=bar -v /data:/data" drun alpine sh -c 'echo $FOO'
#
# Why: a Render service (and every rconsole VM) is itself an unprivileged container, so a real Docker
# daemon cannot run in it. udocker unpacks the image and runs it under proot instead. It suits
# command-line images (hello-world, python, node, alpine, ...). It is NOT Docker: no `-d`,
# `--restart`, `-p` port publishing, networks, compose, or full desktops.
#
# Env: DRUN_OPTS extra `udocker run` options | DRUN_MODE execution mode (default P1; try P2 if P1 fails)
#      DRUN_PULL_OPTS extra `udocker pull` options (e.g. --registry=URL for a private registry)
set -eu

usage() {
  sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit "${1:-2}"
}

case "${1:-}" in
  ""|-h|--help) usage 0 ;;
esac

if ! command -v udocker >/dev/null 2>&1; then
  echo "drun: udocker is not installed here (pip install udocker)." >&2
  exit 127
fi

# proot cannot run inside proot: a rconsole VM is already traced, so use the host shell for this.
if grep -q '^TracerPid:[[:space:]]*[1-9]' /proc/self/status 2>/dev/null; then
  echo "drun: this shell is inside a VM (proot), and proot cannot run inside proot." >&2
  echo "      Run drun from the rconsole host shell instead (vm mode host)." >&2
  exit 1
fi

U="udocker"
[ "$(id -u)" = 0 ] && U="udocker --allow-root"
img="$1"; shift
name="drun_$(printf '%s' "$img" | tr -c 'A-Za-z0-9_.-' '_')"
mode="${DRUN_MODE:-P1}"

# 1. fetch the image once
if ! $U inspect "$img" >/dev/null 2>&1; then
  echo "drun: pulling $img ..." >&2
  # shellcheck disable=SC2086
  $U pull ${DRUN_PULL_OPTS:-} "$img"
fi
# 2. one reusable container per image
if ! $U inspect -p "$name" >/dev/null 2>&1; then
  $U create --name="$name" "$img" >/dev/null
  $U setup --execmode="$mode" "$name" >/dev/null
fi
# 3. images like hello-world ship no /etc and no /root; udocker needs both to start
root="$($U inspect -p "$name" | tail -n 1)"
mkdir -p "$root/etc" "$root/root"
[ -e "$root/etc/passwd" ] || echo 'root:x:0:0:root:/root:/bin/sh' > "$root/etc/passwd"
[ -e "$root/etc/group" ]  || echo 'root:x:0:' > "$root/etc/group"

# shellcheck disable=SC2086
exec $U -q run ${DRUN_OPTS:-} "$name" "$@"
