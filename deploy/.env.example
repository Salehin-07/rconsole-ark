# Copy to `.env` next to docker-compose.yml and fill in. Never commit the real file.

# The public hostname people will open, with DNS already pointing at this server.
RCONSOLE_DOMAIN=console.example.com

# Initial password for the `ark` admin (min 8 chars). Change it later with `sudo cpass`.
RCONSOLE_ADMIN_PASSWORD=change-me-to-something-long
